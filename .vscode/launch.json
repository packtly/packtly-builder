{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "builder_tooling_upload",
            "stopOnEntry": true,
            "type": "debugpy",
            "request": "launch",
            "module": "packtly_builder_tooling.cli",
            "cwd": "${workspaceFolder}/packtly-builder/tooling",
            "args": [
                "--aptlyhost=http://localhost:8080",
                "--credentials-file=${workspaceFolder}/test/aptly-credentials",
                "--dist=trixie-apollo",
                "--component=main",
                "--no-build",
                "--upload",
                "${workspaceFolder}/test/debhello",
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "builder_tooling_build_full",
            "stopOnEntry": true,
            "type": "debugpy",
            "request": "launch",
            "module": "packtly_builder_tooling.cli",
            "cwd": "${workspaceFolder}/packtly-builder/tooling",
            "args": [
                "--aptlyhost=http://localhost:8080",
                "--credentials-file=${workspaceFolder}/test/aptly-credentials",
                "--dist=trixie-apollo",
                "--component=main",
                "--build-mode=full",
                "${workspaceFolder}/test/debhello",
            ],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "poetry",
            "type": "debugpy",
            "request": "launch",
            "program": "/usr/local/bin/poetry",
            "args": ["build"],
            "cwd": "${workspaceFolder}/packtly-builder/tooling",
            "console": "integratedTerminal",
            "justMyCode": false,
            "stopOnEntry": true
        },
        {
            "name": "changelog",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/test/changelog.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "stopOnEntry": true
        },
        {
            "name": "Python: Pytest",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["--no-cov", "${file}"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "stopOnEntry": true
        },
        {
            "name": "Python: Debug Tests",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "purpose": ["debug-test"],
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
