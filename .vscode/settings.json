{
    "maxNumberOfProblems": 100,
    "outputLevel": "debug",
    "editor.formatOnSave": false,
    "python.defaultInterpreterPath": "/opt/poetry-venvs/packtly-builder-tooling-4uYNFs1t-py3.13/bin/python3",
    "python.testing.autoTestDiscoverOnSaveEnabled": true,
    "python.testing.pytestEnabled": true,
    "python.testing.cwd": "${workspaceFolder}",
    "python.testing.pytestArgs": [
        "-s",
        "--verbose",
        "--dpkgbuild=test/debhello",
        "--no-cov",
        "packtly-builder/tooling/packtly_builder_tooling"
    ],
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter",
        "editor.formatOnSave": true
    },
    "[dockerfile]": {
        "editor.defaultFormatter": "ms-azuretools.vscode-containers"
    },
    "[just]": {
        "editor.defaultFormatter": "TobiasHochguertel.just-formatter"
    },
    "python-envs.defaultEnvManager": "ms-python.python:system",
    "coverage-gutters.showGutterCoverage": true,
    "coverage-gutters.showLineCoverage": true,
    "coverage-gutters.coverageFileNames": [
        "coverage.xml"
    ],
}

