{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "packtly_builder_tooling",
            "type": "vscode-just",
            "task": "just",
            "args": [
                "--justfile=${workspaceFolder}/packtly-builder/tooling/justfile",
                "${input:justRecipe}"
            ],
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "justRecipe",
            "type": "pickString",
            "description": "Choose a just recipe to run",
            "options": [
                "black",
                "build",
                "default",
                "flake8",
                "mypy",
                "prepare",
                "pytest",
                "test_keys"
            ],
            "default": "default"
        }
    ]
}
