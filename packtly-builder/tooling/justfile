default: list

list:
    @just --list

prepare:
    #!/usr/bin/env sh
    set -eu

    if ! command -v poetry >/dev/null 2>&1; then
        echo "Please install poetry first: scripts/setup_venv" >&2
        exit 1
    fi

    # Load pip credentials
    creds=""
    if [ -f /etc/pip.conf ] && command -v parse_pip_conf.py >/dev/null 2>&1; then
        creds="$(parse_pip_conf.py -i0 /etc/pip.conf 2>/dev/null || true)"
    fi
    eval "${creds:-}"

    if [ -n "${PIP_USERNAME:-}" ] && [ -n "${PIP_PASSWORD:-}" ]; then
        # Configure poetry with private registry credentials
        poetry config http-basic.aptlyapipypi "$PIP_USERNAME" "$PIP_PASSWORD"
        poetry config http-basic.gitlab "$PIP_USERNAME" "$PIP_PASSWORD"
    else
        echo "No pip credentials found — skipping private registry configuration"
    fi

    # Local project settings
    poetry config virtualenvs.options.system-site-packages true --local

    poetry install --no-interaction --with dev

[private]
_ensure-dev-env:
    #!/usr/bin/env sh
    set -eu

    if ! poetry run python -c "import pytest, mypy, flake8" >/dev/null 2>&1; then
        echo "Dev environment missing or broken → running 'just prepare'"
        just prepare
    fi

[private]
_run-dev +command:
    just _ensure-dev-env
    poetry run {{command}}

test:
    just flake8
    just mypy
    just pytest

pytest:
    just _run-dev pytest

mypy:
    just _run-dev mypy

flake8:
    just _run-dev flake8

cli *args:
    just _run-dev packtly_builder_tooling {{args}}

black:
    just _run-dev black .

build: _ensure-dev-env
    #!/usr/bin/env sh
    set -eu
    if [ -n "${RELEASE_VERSION:-}" ]; then
        poetry version "$RELEASE_VERSION"
    fi
    poetry build

test-keys:
    gen_gpg --name embtom --email xxx@mail.com --pass 1234
