default: list

list:
    @just --list

prepare:
    #!/usr/bin/env sh
    set -eu

    if ! command -v poetry >/dev/null 2>&1; then
        echo "Please install poetry first" >&2
        exit 1
    fi

    # Load pip credentials from the mounted pip.conf (if present)
    creds=""
    if [ -f /etc/pip.conf ] && command -v parse_pip_conf.py >/dev/null 2>&1; then
        creds="$(parse_pip_conf.py -i0 /etc/pip.conf 2>/dev/null || true)"
    fi
    eval "${creds:-}"

    if [ -n "${PIP_USERNAME:-}" ] && [ -n "${PIP_PASSWORD:-}" ]; then
        # Poetry ignores pip.conf, so point it at the private index explicitly.
        # 'poetry source add' rewrites pyproject.toml; restore it on exit to keep
        # the tracked file unchanged (the source is only needed for 'poetry install').
        if [ -n "${PIP_URL:-}" ]; then
            cp pyproject.toml pyproject.toml.bak
            trap 'mv -f pyproject.toml.bak pyproject.toml 2>/dev/null || true' EXIT

            poetry source add --priority=primary private "$PIP_URL"
        fi

        poetry config http-basic.private "$PIP_USERNAME" "$PIP_PASSWORD"
    else
        echo "No pip credentials found — skipping private registry configuration"
    fi
    if [ -z "${VIRTUAL_ENV:-}" ]; then
        echo "No virtualenv active (VIRTUAL_ENV is unset). Create/activate one before running 'just prepare' (e.g. python3 -m venv .venv && . .venv/bin/activate)." >&2
        exit 1
    fi
    rm -f poetry.lock || true
    poetry install --no-interaction --with dev

[private]
_ensure-dev-env:
    #!/usr/bin/env sh
    set -eu

    if ! poetry run python -c "import pytest, mypy, flake8" >/dev/null 2>&1; then
        echo "Dev environment missing or broken → running 'just prepare'"
        just prepare
    fi

[private]
_run-dev +command:
    just _ensure-dev-env
    poetry run {{command}}

test:
    just flake8
    just mypy
    just pytest

pytest:
    just _run-dev pytest

mypy:
    just _run-dev mypy

flake8:
    just _run-dev flake8

cli *args:
    just _run-dev packtly_builder_tooling {{args}}

black:
    just _run-dev black .

build: _ensure-dev-env
    #!/usr/bin/env sh
    set -eu
    if [ -n "${RELEASE_VERSION:-}" ]; then
        poetry version "$RELEASE_VERSION"
    fi
    poetry build

test-keys:
    gen_gpg --name embtom --email xxx@mail.com --pass 1234
